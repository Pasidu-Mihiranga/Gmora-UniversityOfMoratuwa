# Copy to .env in the repository root and fill in. Never commit .env.

# Runtime
SUWAPATH_ENV=development
DATABASE_URL=postgresql+psycopg://suwapath:suwapath@localhost:5432/suwapath

# Gemini on Vertex AI (chat model for the person agents and the single-agent baseline).
# Use either an API key (Vertex express mode) or a service account file.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=

# OpenRouter (Jev decision model for the verifier)
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Security
JWT_SECRET=
# Local key-encryption key that wraps each patient's data key (base64, 32 bytes).
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SUWAPATH_MASTER_KEY=
