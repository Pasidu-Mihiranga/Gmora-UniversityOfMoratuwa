# Copy to .env in the repository root and fill in. Never commit .env.
# With no model keys at all, SuwaPath runs in simulated mode (fake provider, clearly labelled).

# Runtime
# development | demo | production
SUWAPATH_ENV=development
DATABASE_URL=postgresql+psycopg://suwapath:suwapath@localhost:5432/suwapath
WEB_ORIGINS=http://localhost:5173

# Chat model (docs/specs/06-model-gateway.md)
# fake | gemini | openai_compatible (empty: auto)
MODEL_PROVIDER=
# e.g. a Gemini Flash model id on Vertex
MODEL_NAME=
MODEL_NAME_FAST=

# Gemini on Vertex AI: service account file (recommended) or an API key
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# absolute path to the service account JSON (keep it out of git)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=

# Any OpenAI-compatible provider (OpenAI, OpenRouter, Groq, Ollama)
# openai | openrouter | groq | ollama
OPENAI_COMPAT_PRESET=
OPENAI_COMPAT_API_KEY=

# Decision model (Jev) for the verifier, classifier and scores
# decisions | none (empty: auto)
DECISION_PROVIDER=
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Security
# python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SUWAPATH_MASTER_KEY=
# demo accounts only; refused in production
DEMO_PASSWORD=
